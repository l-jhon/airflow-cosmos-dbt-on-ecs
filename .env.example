AWS_REGION=us-east-1
AWS_PROFILE=demo-athena
AWS_ACCOUNT_ID=123456789012

DBT_TARGET=dev
DBT_ATHENA_S3_STAGING_DIR=s3://replace-me-athena-staging/
DBT_ATHENA_S3_TMP_TABLE_DIR=s3://replace-me-athena-staging/tmp/
DBT_ATHENA_RAW_SCHEMA=demo_raw
DBT_ATHENA_STAGE_SCHEMA=demo_stage
DBT_ATHENA_ANALYTICS_SCHEMA=demo_analytics

PROJECT_NAME=airflow-cosmos-dbt-on-ecs
ECR_REPOSITORY=airflow-cosmos-dbt-on-ecs-prod
DBT_MANIFEST_URI=s3://replace-me-manifest/manifest.json

DBT_IMAGE_URI=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:latest
ECS_TASK_EXECUTION_ROLE_ARN=arn:aws:iam::${AWS_ACCOUNT_ID}:role/airflow-cosmos-dbt-on-ecs-ecs-task-execution
ECS_TASK_ROLE_ARN=arn:aws:iam::${AWS_ACCOUNT_ID}:role/airflow-cosmos-dbt-on-ecs-ecs-task
ECS_LOG_GROUP=/ecs/airflow-cosmos-dbt-on-ecs
